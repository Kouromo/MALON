    - target: {fileID: 5448836074641759152, guid: 31a23d4cef3463b4c83028a5d52e1a0f, type: 3}
      propertyPath: m_text
      value: VRAI ou FAUX
      objectReference: {fileID: 0}
    - target: {fileID: 6408903361557365109, guid: 31a23d4cef3463b4c83028a5d52e1a0f, type: 3}
      propertyPath: m_Name
      value: Card VRAI ou FAUX
      objectReference: {fileID: 0}
    - target: {fileID: 7362264659747928859, guid: 31a23d4cef3463b4c83028a5d52e1a0f, type: 3}
      propertyPath: m_text
      value: "Le mode Vrai ou Faux propose une s\xE9rie de questions directement
        adapt\xE9es au poste de travail de chaque collaborateur Orange. L\u2019utilisateur
        doit d\xE9terminer si une affirmation est correcte ou non, puis d\xE9couvre
        une explication claire pour comprendre la bonne r\xE9ponse.\nCe format permet
        d\u2019apprendre rapidement les notions cl\xE9s li\xE9es \xE0 l\u2019utilisation
        de l\u2019IA dans son activit\xE9 quotidienne, de renforcer ses r\xE9flexes
        m\xE9tiers et de mieux saisir comment l\u2019IA peut l\u2019accompagner dans
        ses missions."
      objectReference: {fileID: 0}
    - target: {fileID: 7362264659747928859, guid: 31a23d4cef3463b4c83028a5d52e1a0f, type: 3}
      propertyPath: m_fontSize

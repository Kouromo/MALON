    - target: {fileID: 5448836074641759152, guid: 31a23d4cef3463b4c83028a5d52e1a0f, type: 3}
      propertyPath: m_text
      value: "Cr\xE9er le prompt"
      objectReference: {fileID: 0}
    - target: {fileID: 6408903361557365109, guid: 31a23d4cef3463b4c83028a5d52e1a0f, type: 3}
      propertyPath: m_Name
      value: "Card Cr\xE9er le prompt"
      objectReference: {fileID: 0}
    - target: {fileID: 7362264659747928859, guid: 31a23d4cef3463b4c83028a5d52e1a0f, type: 3}
      propertyPath: m_text
      value: "Dans le mini-jeu Cr\xE9er le prompt, vous devez r\xE9diger un prompt
        en d\xE9crivant un probl\xE8me r\xE9ellement li\xE9 \xE0 votre m\xE9tier
        chez Orange : gestion d\u2019incident, intervention terrain, relation client,
        analyse r\xE9seau, organisation de planning, ou toute autre situation que
        vous rencontrez au quotidien.\nVotre objectif est de formuler une demande
        claire, pr\xE9cise et bien contextualis\xE9e afin d\u2019obtenir de l\u2019IA
        une r\xE9ponse utile et applicable \xE0 votre activit\xE9.\nUne fois votre
        prompt valid\xE9, le jeu vous indique comment l\u2019am\xE9liorer : quelles
        informations ajouter, comment mieux cadrer votre demande et comment guider
        l\u2019IA pour obtenir un r\xE9sultat plus fiable.\nCe mini-jeu vous permet
        ainsi de progresser dans la cr\xE9ation de prompts efficaces et adapt\xE9s
        \xE0 votre poste."
      objectReference: {fileID: 0}
    - target: {fileID: 7362264659747928859, guid: 31a23d4cef3463b4c83028a5d52e1a0f, type: 3}
      propertyPath: m_fontSize
